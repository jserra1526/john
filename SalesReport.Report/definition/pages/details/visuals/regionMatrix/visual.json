                  },
                  "Property": "Region"
                }
              },
              "queryRef": "Customers.Region",
              "nativeQueryRef": "Region"
            },
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Customers"
                    }
                  },
                  "Property": "Country"
                }
              },
              "queryRef": "Customers.Country",
              "nativeQueryRef": "Country"
            }
          ]
        },
        "Columns": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Calendar"
                    }
                  },
                  "Property": "Year"
                }
              },
              "queryRef": "Calendar.Year",
              "nativeQueryRef": "Year"
            }
          ]
        },
        "Values": {
          "projections": [
            {
              "field": {
