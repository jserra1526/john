model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder", "Sales", "Products", "Customers", "Calendar"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table Sales
ref table Products
ref table Customers
ref table Calendar

