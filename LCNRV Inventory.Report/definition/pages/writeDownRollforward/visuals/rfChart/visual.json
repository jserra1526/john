{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "rfChart",
  "position": {
    "x": 16,
    "y": 464,
    "z": 3,
    "width": 1248,
    "height": 244,
    "tabOrder": 3
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Months"
                    }
                  },
                  "Property": "Month"
                }
              },
              "queryRef": "Months.Month",
              "nativeQueryRef": "Month"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Inventory"
                    }
                  },
                  "Property": "Write-down Movement"
                }
              },
              "queryRef": "Inventory.Write-down Movement",
              "nativeQueryRef": "Write-down Movement"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Write-down charge / (release) to COGS by month'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
