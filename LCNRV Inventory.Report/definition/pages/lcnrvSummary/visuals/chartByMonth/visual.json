{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "chartByMonth",
  "position": {
    "x": 16,
    "y": 204,
    "z": 8,
    "width": 1248,
    "height": 200,
    "tabOrder": 8
  },
  "visual": {
    "visualType": "lineClusteredColumnComboChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Months"
                    }
                  },
                  "Property": "Month"
                }
              },
              "queryRef": "Months.Month",
              "nativeQueryRef": "Month"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Inventory"
                    }
                  },
                  "Property": "Total Cost"
                }
              },
              "queryRef": "Inventory.Total Cost",
              "nativeQueryRef": "Total Cost"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Inventory"
                    }
                  },
                  "Property": "LCNRV Value"
                }
              },
              "queryRef": "Inventory.LCNRV Value",
              "nativeQueryRef": "LCNRV Value"
            }
          ]
        },
        "Y2": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Inventory"
                    }
                  },
                  "Property": "Write-down"
                }
              },
              "queryRef": "Inventory.Write-down",
              "nativeQueryRef": "Write-down"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Cost vs LCNRV value by month'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
